{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TADA v5 R7 private gold",
  "description": "Per-cell decoding stays exact. For each question, bal is mean recall over gold-present classes with sheet precision penalties; labels average max(0, (bal - 1/k) / (1 - 1/k)), where k is the full codebook option count, across questions. The compiler separately validates the authoritative instance class guard; synthetic permutation gold may contain singleton classes.",
  "$comment": "Runtime checks must verify label_class_counts against every scored cell, cell-to-label bijection, exact adapter encodings, declared columns, and construction-fact provenance. JSON Schema cannot express those cross-field invariants.",
  "type": "object",
  "required": [
    "schema_version",
    "source",
    "seed",
    "label_aggregation",
    "label_class_counts",
    "weights",
    "sheets",
    "cells",
    "facts",
    "scopes",
    "consistency"
  ],
  "properties": {
    "schema_version": {
      "const": 5
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "seed": {
      "type": "integer"
    },
    "label_aggregation": {
      "const": "per_question_chance_corrected_balanced_accuracy"
    },
    "label_class_counts": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "minProperties": 1,
        "additionalProperties": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "weights": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "labels",
        "scope",
        "facts",
        "consistency"
      ],
      "properties": {
        "labels": {
          "const": 0.7
        },
        "scope": {
          "const": 0.15
        },
        "facts": {
          "const": 0.1
        },
        "consistency": {
          "const": 0.05
        }
      }
    },
    "sheets": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": [
          "columns",
          "key_columns",
          "rows"
        ],
        "properties": {
          "columns": {
            "$ref": "#/$defs/names"
          },
          "key_columns": {
            "$ref": "#/$defs/names"
          },
          "rows": {
            "type": "object",
            "additionalProperties": {
              "type": "object"
            }
          }
        }
      }
    },
    "cells": {
      "type": "array",
      "minItems": 1,
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/cell"
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "benchmark_item"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "required": [
                "checker"
              ],
              "properties": {
                "encoding": {
                  "minItems": 1,
                  "maxItems": 1
                }
              }
            },
            "else": {
              "properties": {
                "encoding": {
                  "minItems": 2
                }
              }
            }
          }
        ],
        "required": [
          "record",
          "question",
          "answer",
          "encoding",
          "source",
          "origin"
        ],
        "properties": {
          "record": {
            "type": "string",
            "minLength": 1
          },
          "question": {
            "type": "string",
            "minLength": 1
          },
          "answer": {},
          "encoding": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "prefixItems": [
                {},
                {
                  "type": "string"
                }
              ]
            }
          },
          "source": {
            "type": "string"
          },
          "origin": {
            "type": "object",
            "required": [
              "source",
              "record",
              "question"
            ],
            "additionalProperties": false,
            "properties": {
              "source": {
                "type": "string",
                "minLength": 1
              },
              "record": {
                "type": "string",
                "minLength": 1
              },
              "question": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "kind": {
            "enum": [
              "record_label",
              "benchmark_item"
            ]
          },
          "checker": {
            "type": "object"
          }
        }
      }
    },
    "facts": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/cell"
          }
        ],
        "required": [
          "value"
        ],
        "properties": {
          "value": {
            "type": [
              "string",
              "number",
              "boolean",
              "null"
            ]
          }
        }
      }
    },
    "scopes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "work_item",
          "sheet",
          "column",
          "expected_keys"
        ],
        "properties": {
          "work_item": {
            "type": "string",
            "minLength": 1
          },
          "sheet": {
            "type": "string",
            "minLength": 1
          },
          "column": {
            "type": "string",
            "minLength": 1
          },
          "expected_keys": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/key"
            }
          }
        }
      }
    },
    "consistency": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/cell"
          }
        ],
        "required": [
          "dependencies",
          "operation"
        ],
        "properties": {
          "dependencies": {
            "$ref": "#/$defs/names"
          },
          "operation": {
            "enum": [
              "count_option",
              "count_changed",
              "count_answered"
            ]
          },
          "option": {
            "type": [
              "string",
              "number",
              "null"
            ]
          }
        },
        "not": {
          "anyOf": [
            {
              "required": [
                "answer"
              ]
            },
            {
              "required": [
                "value"
              ]
            },
            {
              "required": [
                "gold"
              ]
            }
          ]
        },
        "if": {
          "properties": {
            "operation": {
              "const": "count_option"
            }
          }
        },
        "then": {
          "required": [
            "option"
          ]
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "names": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "key": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "cell": {
      "type": "object",
      "required": [
        "id",
        "sheet",
        "key",
        "column",
        "work_item"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "sheet": {
          "type": "string",
          "minLength": 1
        },
        "key": {
          "$ref": "#/$defs/key"
        },
        "column": {
          "type": "string",
          "minLength": 1
        },
        "work_item": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
