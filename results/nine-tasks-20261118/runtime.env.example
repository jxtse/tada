# Copy this template to the restored main experiment's runconfig/runtime.env.local.
# Configure and sign in to the model service on the NEW computer first.
# OPENAI_BASE_URL must be an HTTP(S) API prefix, without embedded credentials,
# query parameters, or a fragment. A trailing /v1 is supported.
OPENAI_BASE_URL=http://127.0.0.1:18142/v1
OPENAI_API_KEY=REPLACE_WITH_YOUR_NEW_MACHINE_API_KEY

# Keep runtime.env.local private and out of Git. Do not copy this example's
# placeholder as a working credential. This file does not start the service.
